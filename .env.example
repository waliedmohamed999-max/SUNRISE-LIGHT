# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://sunrise:CHANGE_ME@localhost:5433/sunrise_light"
POSTGRES_PASSWORD="CHANGE_ME"   # use a long random value

# ── Application ───────────────────────────────────────────
# Public origin, used for canonical URLs, sitemap and CSRF origin checks
APP_URL="http://localhost:3000"
# development | staging | production
APP_ENV="development"

# ── File storage ──────────────────────────────────────────
# "local" stores private files under STORAGE_DIR (never inside /public).
# "s3" is the production target (S3-compatible, private bucket) — see docs/DEPLOYMENT.md.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="10"

# ── Notifications ─────────────────────────────────────────
# Leave empty to disable outbound email. Notifications are then recorded as SKIPPED
# and only shown in-app. No message leaves the server until a provider is configured.
RESEND_API_KEY=""
EMAIL_FROM=""
SALES_TEAM_EMAIL=""

# ── Security ──────────────────────────────────────────────
# Encrypts two-step verification (TOTP) secrets. Generate with:
#   node -e "console.log(require(crypto).randomBytes(48).toString(base64url))"
MFA_ENCRYPTION_KEY=""
# true = factory staff must enable two-step verification before using the dashboard (recommended in production)
REQUIRE_STAFF_MFA="false"
# Number of trusted reverse proxies in front of the app (used to read the real client IP for rate limits)
TRUST_PROXY_HOPS="1"
# Separate owner credentials used only for "prisma migrate deploy" (runtime DATABASE_URL can then be least-privilege)
MIGRATION_DATABASE_URL=""

# ── Seed: first super admin (used by `npm run db:seed`) ───
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="CHANGE_ME"   # at least 12 characters; rotate after first login
